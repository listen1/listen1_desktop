{
  "name": "listen1",
  "version": "2.35.1",
  "description": "One for all free music in China",
  "main": "app/main.js",
  "scripts": {
    "postinstall": "install-electron && electron-builder install-app-deps",
    "start": "electron ./app --enable-logging",
    "dev": "node scripts/dev.cjs",
    "dist:mac": "electron-builder --mac --publish never",
    "dist": "electron-builder --publish never",
    "dist:linux": "electron-builder --linux --x64 --arm64 --publish never",
    "dist:linux64": "electron-builder --linux --x64 --publish never",
    "dist:linuxArm64": "electron-builder --linux --arm64 --publish never",
    "dist:win": "electron-builder --win --publish never",
    "dist:win:test": "node scripts/build-windows-test.cjs",
    "test": "node --test tests/*.test.cjs app/listen1_chrome_extension/test/*.test.cjs",
    "test:electron": "node tests/electron-smoke.cjs",
    "test:online": "node tests/online-ui.cjs",
    "test:lyrics": "node tests/lyrics-electron.cjs",
    "test:lyrics:online": "node tests/lyrics-electron.cjs --online",
    "test:visual": "node tests/visual-electron.cjs",
    "test:visual:online": "node tests/visual-electron.cjs --online"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MapleSugarCake/listen1_desktop.git"
  },
  "keywords": [
    "Electron",
    "Listen 1"
  ],
  "author": "Listen 1 <githublisten1@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/MapleSugarCake/listen1_desktop/issues"
  },
  "homepage": "https://github.com/MapleSugarCake/listen1_desktop",
  "engines": {
    "node": ">=24.21.0 <25",
    "npm": ">=12 <13"
  },
  "packageManager": "npm@12.0.2",
  "allowScripts": {
    "electron-winstaller": false
  },
  "build": {
    "appId": "com.listen1.listen1",
    "productName": "Listen1",
    "asar": true,
    "artifactName": "${name}_${version}_${os}_${arch}.${ext}",
    "publish": {
      "provider": "github",
      "owner": "MapleSugarCake",
      "repo": "listen1_desktop"
    },
    "files": [
      "**/*",
      "!listen1_chrome_extension/{node_modules,test,scripts,.github,.husky}/**",
      "!listen1_chrome_extension/{package-lock.json,package.json,eslint.config.mjs}",
      "!**/AGENTS.md"
    ],
    "dmg": {
      "icon": "build/disk.icns",
      "contents": [
        {
          "x": 192,
          "y": 344
        },
        {
          "x": 448,
          "y": 344,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "mac": {
      "minimumSystemVersion": "13.0.0",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64",
            "universal"
          ]
        }
      ],
      "category": "public.app-category.music"
    },
    "linux": {
      "target": [
        "tar.gz",
        "appImage",
        "deb"
      ],
      "category": "Audio"
    },
    "nsis": {
      "runAfterFinish": false,
      "deleteAppDataOnUninstall": true,
      "allowToChangeInstallationDirectory": true,
      "oneClick": false,
      "installerLanguages": "zh_CN",
      "language": 2052,
      "perMachine": true,
      "createDesktopShortcut": true
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "7z",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    }
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3",
    "prettier": "3.9.8",
    "playwright": "1.63.0"
  }
}
